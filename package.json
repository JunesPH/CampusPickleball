{
  "name": "campus-pickleball",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:check": "node --conditions=react-server scripts/db.mjs check",
    "db:migrate": "node --conditions=react-server scripts/db.mjs migrate",
    "db:seed": "node --conditions=react-server scripts/db.mjs seed",
    "db:verify": "node --conditions=react-server scripts/db.mjs verify",
    "test:db": "node --conditions=react-server --test tests/db.test.mjs",
    "test:profiles": "node --conditions=react-server --test tests/profiles.test.mjs",
    "test:profiles:db": "RUN_PROFILE_DB_TESTS=1 node --conditions=react-server --test tests/profiles.integration.test.mjs"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@next/env": "^16.4.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
