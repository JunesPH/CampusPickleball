# Copy to .env.local. Use the existing Tiger Cloud service's PostgreSQL URL.
# URL-encode special characters in the username/password. Never use NEXT_PUBLIC_.
DATABASE_URL=postgresql://YOUR_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_TIGER_HOST:YOUR_PORT/YOUR_DATABASE?sslmode=verify-full
# Optional: absolute path to a trusted CA PEM if your service requires one.
# DATABASE_SSL_CA_FILE=/absolute/path/to/tiger-ca.pem
